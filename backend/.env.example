# 默认 LLM 配置（支持 DeepSeek、OpenAI、Claude、Gemini 和 OpenAI 兼容服务）
# 说明：
# 1. 前端现在可以在请求时动态传入 provider、apiKey、baseUrl、model
# 2. 以下环境变量仅作为后端兜底默认值
# 3. DeepSeek 也兼容 DEEPSEEK_API_KEY、DEEPSEEK_API_BASE_URL、DEEPSEEK_MODEL
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# 通用变量名：
# API_KEY=your_api_key_here
# API_BASE_URL=https://api.deepseek.com/v1

# 支持的 provider：
# - openai
# - deepseek
# - claude
# - gemini
# - openai-compatible

# OpenAI
# LLM_PROVIDER=openai
# API_KEY=your_openai_api_key
# API_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# DeepSeek
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

# SparkAI:
# LLM_PROVIDER=spark
# API_KEY=your_spark_api_key
# API_SECRET=your_spark_api_secret
# API_BASE_URL=https://spark-api-open.xf-yun.com/v3.5/chat/completions
# MODEL_NAME=spark-3.5

# Claude / Anthropic
# LLM_PROVIDER=claude
# API_KEY=your_anthropic_api_key
# API_BASE_URL=https://api.anthropic.com/v1
# MODEL_NAME=claude-3-5-sonnet-latest

# Gemini（通过 OpenAI 兼容接口）
# LLM_PROVIDER=gemini
# API_KEY=your_gemini_api_key
# API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL_NAME=gemini-2.0-flash

# 自定义 OpenAI 兼容服务
# LLM_PROVIDER=openai-compatible
# API_KEY=your_api_key
# API_BASE_URL=https://your-proxy.com/v1
# MODEL_NAME=your-model-name
