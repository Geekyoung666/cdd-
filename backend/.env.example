# LLM 配置（默认使用 DeepSeek，兼容 OpenAI Chat Completions 格式）
LLM_PROVIDER=openai
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 也兼容旧变量名：
# API_KEY=your_api_key_here
# API_BASE_URL=https://api.deepseek.com

# SparkAI 额外配置（使用 spark 时需要）
API_SECRET=your_api_secret_here

# 示例配置：
# Google Gemini:
# LLM_PROVIDER=gemini
# API_KEY=your_gemini_api_key
# MODEL_NAME=gemini-1.5-flash

# OpenAI:
# LLM_PROVIDER=openai
# API_KEY=your_openai_api_key
# API_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-3.5-turbo

# DeepSeek:
# LLM_PROVIDER=openai
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-chat

# SparkAI:
# LLM_PROVIDER=spark
# API_KEY=your_spark_api_key
# API_SECRET=your_spark_api_secret
# API_BASE_URL=https://spark-api-open.xf-yun.com/v3.5/chat/completions
# MODEL_NAME=spark-3.5

# 自定义 API（兼容 OpenAI 格式）:
# LLM_PROVIDER=openai
# API_KEY=your_api_key
# API_BASE_URL=https://your-proxy.com/v1
# MODEL_NAME=your-model-name
